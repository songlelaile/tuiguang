# ============ tuiguang BI 部署配置模板 ============
# 复制为 .env 后再编辑：
#   cp .env.example .env

# 对外暴露的 HTTP 端口（nginx 入口）
APP_PORT=80

# 上传文件在宿主机上的存放路径
# 生产环境强烈建议指向纳入备份的目录，如 /var/lib/tuiguang/uploads
# 留默认 ./uploads 仅适合本机测试
UPLOADS_HOST_DIR=./uploads

# 单文件上传上限（MB）
# 调大此值时，请同步修改 docker/nginx.conf 里的 client_max_body_size
UPLOAD_MAX_MB=100

# 容器时区
TZ=Asia/Shanghai
