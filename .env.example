# ============ tuiguang BI 部署配置模板 ============
# 复制为 .env 后再编辑：
#   cp .env.example .env
#
# 两种部署模式：
#   1) 主域名子站部署（默认推荐）—— 例：tuiguang.shaozhuangai.com
#      主服务器现有 nginx 接管 TLS + 反代到本机 APP_BIND_PORT;应用层接管认证
#      启动：docker compose up -d --build
#      详见 deploy/host-nginx-deploy.md
#
#   2) 独立部署（无现有主域名）—— 直接访问 http://服务器IP/
#      容器内 nginx 仅做反代;HTTPS 暂不做;应用层接管认证
#      启动：docker compose --profile standalone up -d --build
#      详见 deploy/standalone-deploy.md
#
# 鉴权:从 P4 起 nginx 层 Basic Auth 已下线,改由应用层 cookie session + 邀请码注册;
# 见 ADMIN_BOOTSTRAP_* 引导首个管理员的配置项。

# ---- 模式 1（主域名子站）专用 ----
# tuiguang app 在宿主机 loopback 上暴露的端口；主 nginx 反代过来
# 与主服务器其它本地服务冲突时换一个（如 5181 / 5182）
APP_BIND_PORT=5180

# ---- 模式 2（独立部署）专用 ----
# 对外暴露的 HTTP 端口（容器内 nginx 入口）
APP_PORT=80

# ---- 两种模式共用 ----

# 上传文件在宿主机上的存放路径
# 生产环境强烈建议指向纳入备份的目录，如 /var/lib/tuiguang/uploads
UPLOADS_HOST_DIR=./uploads

# SQLite 长期历史库 + 启动 seed 备份目录
# 生产环境推荐：/var/lib/tuiguang/data
# 这个卷必须做备份，丢了等于所有历史数据丢了
DATA_HOST_DIR=./data

# 单文件上传上限（MB）
# 调大此值时，请同步修改：
#   - 模式 1：主 nginx 配置里的 client_max_body_size（见 deploy/host-nginx-tuiguang.conf.example）
#   - 模式 2：docker/nginx.conf 里的 client_max_body_size
UPLOAD_MAX_MB=100

# 容器时区
TZ=Asia/Shanghai

# ---- 账号系统(P4) ----

# 引导首个管理员:仅在 users 表为空时,启动时按这对凭据创建 admin。
# 创建完后,密码已经哈希入 SQLite,可以(也建议)从 .env 撤掉以免明文长期留存。
# 升级老库的场景:这两项必填,否则启动会拒绝(避免老数据归属未知用户)。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# session 有效期(天)。默认 14。session token 存在 SQLite,可即时吊销。
SESSION_TTL_DAYS=14
